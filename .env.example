# --- Google Sheets "database" (service account) ---
# Create a service account in Google Cloud Console, enable the Sheets API
# and Drive API, then share your spreadsheet with this service account's
# email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=haims-sa@your-project.iam.gserviceaccount.com
# Paste the private_key from the service account JSON key. Keep the \n escapes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=1f_0Vw7BDVWqu5mIh3wlAhpK1IepxBGV7nK1GsWmi4AQ

# --- Google Drive folder for photo uploads ---
# Create a Drive folder, share it with the service account email as Editor,
# and paste its folder ID (from the folder's URL) here.
HAIMS_DRIVE_ROOT_FOLDER_ID=

# --- "Lanjut dengan akun Google" login (OAuth2, separate from the service account) ---
# Create an OAuth 2.0 Client ID (Web application) in the same or another
# Google Cloud project. Authorized redirect URI:
#   https://<your-vercel-domain>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Session cookie signing ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional email notifications (OTP, admin alerts) via Resend ---
RESEND_API_KEY=
MAIL_FROM=HAIMS <no-reply@yourdomain.com>

# --- Optional ---
APP_TIMEZONE=Asia/Jakarta
